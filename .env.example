# Copy to .env and fill in. Only the first line is required.

# Your Chess.com username.
CHESSCOM_USERNAME=

# Chess.com rejects requests without a recognisable user agent (403).
# Putting a way to contact you in here is good manners.
# CHESS_USER_AGENT=knightmare/1.0 (self-hosted; you@example.com)

# Port on your machine.
# PORT=8000

# How far back to go on the first run.
# CHESS_BACKFILL_MONTHS=6

# How often to check for new games.
# CHESS_SYNC_INTERVAL_HOURS=6

# Seconds of engine time per position. Higher is more accurate and slower.
# CHESS_ENGINE_MOVETIME=0.15

# Stockfish threads and hash. Raise on a beefy machine.
# CHESS_ENGINE_THREADS=2
# CHESS_ENGINE_HASH_MB=256

# Games analysed per run - keeps the machine from being busy for hours.
# CHESS_MAX_GAMES_PER_RUN=40

# Which game types to fetch.
# CHESS_TIME_CLASSES=bullet,blitz,rapid,daily

# Mistake thresholds in centipawns.
# CHESS_INACCURACY_CP=50
# CHESS_MISTAKE_CP=100
# CHESS_BLUNDER_CP=300

# Postgres instead of SQLite, if you already run one:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
