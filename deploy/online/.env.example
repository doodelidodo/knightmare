# Your domain - its DNS A record must point to this server.
DOMAIN=knightmare.example.com

# Shown on the privacy page and sent to Chess.com/Lichess in the user agent.
ONLINE_OPERATOR=Your Name
ONLINE_CONTACT=you@example.com

# Optional - defaults shown.
# ONLINE_GAMES=30            newest games analysed per player
# ONLINE_KEEP_DAYS=30        delete players not visited for this long
# ONLINE_REFRESH_HOURS=6     fetch again at most this often per player
# ONLINE_PER_IP_HOUR=6       new analyses per IP address and hour
# ONLINE_QUEUE_MAX=100       longest queue
# CHESS_ENGINE_THREADS=2     match the number of vCPUs
# CHESS_RATED_ONLY=0         1 = rated games only
